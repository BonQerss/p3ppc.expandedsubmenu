import("ModMenu/ModMenu.flow");
import("Setup/FirstTimeSetup.flow");

global bool isFieldBf;

void f014_010_shortcut_hook()
{
    isFieldBf = false;

    if (!BIT_CHK(5153))
    {
        FirstTimeSetup();
        return;
    }

    if (BIT_CHK(5154))
    {
        ModMenuInit();
        return;
    }

    f014_010_shortcut_unhooked();
}

void CallOriginalSquareMenu()
{
    f014_010_shortcut_unhooked();
}
