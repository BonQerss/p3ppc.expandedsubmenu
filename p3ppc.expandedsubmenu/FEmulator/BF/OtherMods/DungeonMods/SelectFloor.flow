import("SelectFloor.msg");

void SelectFloor()
{
    int FloorWarp;
    int FloorWarpConfirm;
    int WarpConfirm;
    int TooHigh;
    int Else;
    int YesNoConfirm;

    if (BIT_CHK(3123))
    {
        FloorWarp = ItemPrompt_F;
        FloorWarpConfirm = FloorConfirm_F;
        WarpConfirm = WarpConfirm_F;
        TooHigh = TooHigh_F;
        Else = AnythingElse_F;
        naviCutin = 6;
        naviBup = naviCutin;
        gVar97 = 4;
    }
    else
    {
        FloorWarp = ItemPrompt_M;
        FloorWarpConfirm = FloorConfirm_M;
        WarpConfirm = WarpConfirm_M;
        TooHigh = TooHigh_M;
        Else = AnythingElse_M;
        naviCutin = 4;
        naviBup = naviCutin;
        gVar97 = naviCutin;
    }

    if (BIT_CHK(4104))
    {
        YesNoConfirm = ESCAPE_SEL_G;
    }
    else
    {
        YesNoConfirm = ESCAPE_SEL;
    }

TRYAGAIN:
    FUNCTION_0064(0, 0, 0, naviCutin, 0, 0, 0);
    MSG_WND_DSP();
    MSG(FloorWarp);
    MSG_WND_CLS();
    gNumberMenuTitle = FloorSelectTitle;
    int floor = SelectNumber(3);
    gNumberMenuTitle = 0;

    if ((floor != -1) && (floor >= 2))
    {
        MSG_WND_DSP();
        FUNCTION_0064(0, 0, 0, naviCutin, 0, 0, 0);
        SET_MSG_VAR(0, floor, 0);
        MSG(FloorWarpConfirm);
        SEL_DEFKEY(PadButton.Circle, 1);
        int YESNO = SEL(YesNoConfirm);

        if (YESNO == 0)
        {
            if (floor > GET_COUNT(8))
            {
                FUNCTION_0064(0, 0, 0, naviCutin, 2, 0, 0);
                MSG(TooHigh);
                MSG_WND_CLS();
                FUNCTION_0065(0);
                return;
            }

            MSG(WarpConfirm);
            MSG_WND_CLS();
            FUNCTION_0065(0);
            FADE(3, 20);
            FUNCTION_000F();
            FCL_FUNCTION_0004(floor);
            return;
        }

        FUNCTION_0064(0, 0, 0, naviCutin, 0, 0, 0);
        MSG(Else);
        SEL_DEFKEY(PadButton.Circle, 1);

        if (!SEL(YesOrNo))
        {
            MSG_WND_CLS();
            goto TRYAGAIN;
        }

        MSG_WND_CLS();
        FUNCTION_0065(0);
        return;
    }

    FUNCTION_0065(0);
}
