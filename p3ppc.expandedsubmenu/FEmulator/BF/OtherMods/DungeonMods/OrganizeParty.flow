import("OrganizeParty.msg");

global(21) int allyCount;
global(32) int removeAlly;
global(37) int currentFloor;

bool partyChanged;

int get_ally_mask(int id)
{
    switch (id)
    {
        case PartyMember.Yukari:
            return 1;
        case PartyMember.Aigis:
            return 2;
        case PartyMember.Mitsuru:
            return 4;
        case PartyMember.Junpei:
            return 8;
        case PartyMember.Akihiko:
            return 16;
        case PartyMember.Ken:
            return 32;
        case 9:
            return 64;
        case PartyMember.Koromaru:
            return 128;
        default:
            break;
    }
    return 0;
}

bool ally_in_party(int id)
{
    int i = 0;
    while (i < 3)
    {
        if (FUNCTION_0042(i) == id)
        {
            return true;
        }
        i = i + 1;
    }
    return false;
}

int get_party_mask()
{
    int maskVal = 0xFF;
    int i = 0;
    while (i < 3)
    {
        maskVal = maskVal - get_ally_mask(FUNCTION_0042(i));
        i = i + 1;
    }
    return maskVal;
}

int get_avail_mask()
{
    int maskVal = 0xFF;
    int cAllyID;
    int i = 2;

    while (i < 10)
    {
        if (i >= 6)
        {
            cAllyID = i + 1;
        }
        else
        {
            cAllyID = i;
        }

        if ((BIT_CHK(320 + i) || BIT_CHK(5154)) && !ally_in_party(cAllyID))
        {
            maskVal = maskVal - get_ally_mask(cAllyID);
        }

        i = i + 1;
    }

    return maskVal;
}

void member_add(int id)
{
    if (id == 0)
    {
        PARTY_IN(PartyMember.Yukari);
    }
    else if (id == 1)
    {
        PARTY_IN(PartyMember.Aigis);
    }
    else if (id == 2)
    {
        PARTY_IN(PartyMember.Mitsuru);
    }
    else if (id == 3)
    {
        PARTY_IN(PartyMember.Junpei);
    }
    else if (id == 4)
    {
        PARTY_IN(PartyMember.Akihiko);
    }
    else if (id == 5)
    {
        PARTY_IN(PartyMember.Ken);
    }
    else if (id == 6)
    {
        PARTY_IN(9);
    }
    else if (id == 7)
    {
        PARTY_IN(PartyMember.Koromaru);
    }
}

void add_members()
{
    int allyMask;
    int allyChoice;

ADD_ANOTHER:
    allyMask = get_avail_mask();
    if (allyCount >= 3 || allyMask == 0xFF)
    {
        if (allyCount >= 3)
        {
            MSG(FULL_PARTY);
        }
        else
        {
            MSG(NOBODY_AVAIL);
        }
        return;
    }

    MSG(WHO_TO_ADD);
    SEL_DEFKEY(14, 8);
    FUNCTION_0006(allyMask);
    allyChoice = SEL(PARTY_MEMBERS);

    if (allyChoice >= 8)
    {
        return;
    }

    member_add(allyChoice);
    MSG_WND_CLS();
    allyCount = allyCount + 1;
    partyChanged = true;
    MSG_WND_DSP();
    goto ADD_ANOTHER;
}

void remove_members()
{
REMOVE_ANOTHER:
    if (allyCount <= 0)
    {
        MSG(EMPTY_PARTY);
        allyCount = 0;
        return;
    }

    MSG(REMOVE);
    SEL_DEFKEY(14, 8);
    FUNCTION_0006(get_party_mask());
    removeAlly = SEL(PARTY_MEMBERS);

    if (removeAlly >= 8)
    {
        return;
    }

    member_change();
    MSG_WND_CLS();
    allyCount = allyCount - 1;
    partyChanged = true;
    MSG_WND_DSP();
    goto REMOVE_ANOTHER;
}

void change_party()
{
    int editResponse;

RESTART:
    MSG(REMOVE_OR_ADD);
    SEL_DEFKEY(14, 2);
    editResponse = SEL(REMOVE_OR_ADD_SEL);

    if (editResponse == 0)
    {
        add_members();
        MSG_WND_CLS();
        MSG_WND_DSP();
        goto RESTART;
    }
    else if (editResponse == 1)
    {
        remove_members();
        MSG_WND_CLS();
        MSG_WND_DSP();
        goto RESTART;
    }

    MSG_WND_CLS();
    if (partyChanged)
    {
        FADE(3, 20);
        FUNCTION_000F();
        FCL_FUNCTION_0004(currentFloor);
        partyChanged = false;
    }
}
