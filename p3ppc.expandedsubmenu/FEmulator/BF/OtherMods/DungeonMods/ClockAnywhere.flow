import("ClockAnywhere.msg");

void HealingClock()
{
    MSG_WND_DSP();
    MSG(WHAT_DO_YOU_WANT);
    SEL_DEFKEY(PadButton.Circle, 4);
    FUNCTION_0006(!BIT_CHK(5159));
    int saveSel = SEL(SAVE_OR_HEAL);
    MSG_WND_CLS();

    if (saveSel == 0)
    {
        FADE(FadeEffects.FadeOut, 10);
        FUNCTION_000F();
        SAVE_MENU();
        FUNCTION_000D(0);
        FUNCTION_000F();
    }
    else if (saveSel == 1)
    {
        HealParty();
    }
    else if (saveSel == 2)
    {
        HealEveryone();
    }
    else if (saveSel == 3)
    {
        BattleTutorials();
    }
}

void HealParty()
{
    int partySP = GET_SP(PartyMember.Protagonist);
    int partyMaxSP = GET_MAXSP(PartyMember.Protagonist);
    int partyHP = GET_HP(PartyMember.Protagonist);
    int partyMaxHP = GET_MAXHP(PartyMember.Protagonist);
    int i = 0;

    while (i < 3)
    {
        int allyID = FUNCTION_0042(i);
        if (allyID != 0)
        {
            partySP = partySP + GET_SP(allyID);
            partyMaxSP = partyMaxSP + GET_MAXSP(allyID);
            partyHP = partyHP + GET_HP(allyID);
            partyMaxHP = partyMaxHP + GET_MAXHP(allyID);
        }
        i = i + 1;
    }

    int baseCost = GetBaseCost();
    int finalCost = ((partyMaxSP - partySP) * baseCost) / 10;
    finalCost = finalCost + (((partyMaxHP - partyHP) * baseCost) / 100);

    if (finalCost > 9999999)
    {
        finalCost = 9999999;
    }
    else if (finalCost == 0)
    {
        MSG_WND_DSP();
        MSG(HEAL_NOMORE);
        MSG_WND_CLS();
        return;
    }

    if (BIT_CHK(4891))
    {
        finalCost = finalCost / 2;
    }

    int playerMoney = ADD_PC_MONEY(0);
    MSG_WND_DSP();
    SET_MSG_VAR(0, finalCost, 0);
    SET_MSG_VAR(1, playerMoney, 0);
    MSG(HEAL_REQUIRE);
    SEL_DEFKEY(PadButton.Circle, 1);

    if (SEL(HEAL_OK) == 0)
    {
        if (finalCost > playerMoney)
        {
            MSG(HEAL_NOMONEY);
        }
        else
        {
            finalCost = finalCost * -1;
            ADD_PC_MONEY(finalCost);
            MSG_WND_CLS();
            RecoverParty();
            MSG_WND_DSP();
            MSG(HEAL_DONE_PT);
        }
    }

    MSG_WND_CLS();
}

void RecoverParty()
{
    SET_SP(PartyMember.Protagonist, GET_MAXSP(PartyMember.Protagonist));
    SET_HP(PartyMember.Protagonist, GET_MAXHP(PartyMember.Protagonist));
    FUNCTION_0020(2, 20);
    FUNCTION_0010(FadeEffects.FadeOut, 5, 255, 255, 255);
    FUNCTION_000F();
    FUNCTION_000D(15);
    FUNCTION_000F();

    int i = 0;
    while (i < 3)
    {
        int allyID = FUNCTION_0042(i);
        if (allyID != 0)
        {
            SET_SP(allyID, GET_MAXSP(allyID));
            SET_HP(allyID, GET_MAXHP(allyID));
        }
        i = i + 1;
    }
}

void HealEveryone()
{
    int allySP = GET_SP(PartyMember.Protagonist);
    int allyMaxSP = GET_MAXSP(PartyMember.Protagonist);
    int allyHP = GET_HP(PartyMember.Protagonist);
    int allyMaxHP = GET_MAXHP(PartyMember.Protagonist);

    if (BIT_CHK(3099))
    {
        allySP = allySP + GET_SP(PartyMember.Junpei);
        allyMaxSP = allyMaxSP + GET_MAXSP(PartyMember.Junpei);
        allyHP = allyHP + GET_HP(PartyMember.Junpei);
        allyMaxHP = allyMaxHP + GET_MAXHP(PartyMember.Junpei);
    }

    if (BIT_CHK(3096))
    {
        allySP = allySP + GET_SP(PartyMember.Yukari);
        allyMaxSP = allyMaxSP + GET_MAXSP(PartyMember.Yukari);
        allyHP = allyHP + GET_HP(PartyMember.Yukari);
        allyMaxHP = allyMaxHP + GET_MAXHP(PartyMember.Yukari);
    }

    if (BIT_CHK(3100))
    {
        allySP = allySP + GET_SP(PartyMember.Akihiko);
        allyMaxSP = allyMaxSP + GET_MAXSP(PartyMember.Akihiko);
        allyHP = allyHP + GET_HP(PartyMember.Akihiko);
        allyMaxHP = allyMaxHP + GET_MAXHP(PartyMember.Akihiko);
    }

    if (BIT_CHK(3098) && BIT_CHK(3123))
    {
        allySP = allySP + GET_SP(PartyMember.Mitsuru);
        allyMaxSP = allyMaxSP + GET_MAXSP(PartyMember.Mitsuru);
        allyHP = allyHP + GET_HP(PartyMember.Mitsuru);
        allyMaxHP = allyMaxHP + GET_MAXHP(PartyMember.Mitsuru);
    }

    if (BIT_CHK(3097))
    {
        allySP = allySP + GET_SP(PartyMember.Aigis);
        allyMaxSP = allyMaxSP + GET_MAXSP(PartyMember.Aigis);
        allyHP = allyHP + GET_HP(PartyMember.Aigis);
        allyMaxHP = allyMaxHP + GET_MAXHP(PartyMember.Aigis);
    }

    if (BIT_CHK(3101))
    {
        allySP = allySP + GET_SP(PartyMember.Ken);
        allyMaxSP = allyMaxSP + GET_MAXSP(PartyMember.Ken);
        allyHP = allyHP + GET_HP(PartyMember.Ken);
        allyMaxHP = allyMaxHP + GET_MAXHP(PartyMember.Ken);
    }

    if (BIT_CHK(3102))
    {
        allySP = allySP + GET_SP(9);
        allyMaxSP = allyMaxSP + GET_MAXSP(9);
        allyHP = allyHP + GET_HP(9);
        allyMaxHP = allyMaxHP + GET_MAXHP(9);
    }

    if (BIT_CHK(3103))
    {
        allySP = allySP + GET_SP(PartyMember.Koromaru);
        allyMaxSP = allyMaxSP + GET_MAXSP(PartyMember.Koromaru);
        allyHP = allyHP + GET_HP(PartyMember.Koromaru);
        allyMaxHP = allyMaxHP + GET_MAXHP(PartyMember.Koromaru);
    }

    int baseCost = GetBaseCost();
    int finalCost = ((allyMaxSP - allySP) * baseCost) / 10;
    finalCost = finalCost + (((allyMaxHP - allyHP) * baseCost) / 100);

    if (finalCost > 9999999)
    {
        finalCost = 9999999;
    }
    else if (finalCost == 0)
    {
        MSG_WND_DSP();
        MSG(HEAL_NOMORE);
        MSG_WND_CLS();
        return;
    }

    if (BIT_CHK(4891))
    {
        finalCost = finalCost / 2;
    }

    int playerMoney = ADD_PC_MONEY(0);
    MSG_WND_DSP();
    SET_MSG_VAR(0, finalCost, 0);
    SET_MSG_VAR(1, playerMoney, 0);
    MSG(HEAL_REQUIRE);
    SEL_DEFKEY(PadButton.Circle, 1);

    if (SEL(HEAL_OK) == 0)
    {
        if (finalCost > playerMoney)
        {
            MSG(HEAL_NOMONEY);
        }
        else
        {
            finalCost = finalCost * -1;
            ADD_PC_MONEY(finalCost);
            MSG_WND_CLS();
            FUNCTION_0020(2, 20);
            FUNCTION_0010(FadeEffects.FadeOut, 5, 255, 255, 255);
            FUNCTION_000F();
            FUNCTION_000D(15);
            FUNCTION_000F();
            FUNCTION_0049();
            MSG_WND_DSP();
            MSG(HEAL_DONE);
        }
    }

    MSG_WND_CLS();
}

int GetBaseCost()
{
    if (CHK_DAYS_STARTEND(Month.April, 1, Month.May, 9))
    {
        return 75;
    }
    else if (CHK_DAYS_STARTEND(Month.May, 10, Month.June, 12))
    {
        return 100;
    }
    else if (CHK_DAYS_STARTEND(Month.June, 13, Month.July, 8))
    {
        return 150;
    }
    else if (CHK_DAYS_STARTEND(Month.July, 9, Month.August, 7))
    {
        return 230;
    }
    else if (CHK_DAYS_STARTEND(Month.August, 8, Month.September, 9))
    {
        return 480;
    }
    else if (CHK_DAYS_STARTEND(Month.September, 10, Month.October, 5))
    {
        return 780;
    }
    else if (CHK_DAYS_STARTEND(Month.October, 6, Month.November, 5))
    {
        return 1500;
    }
    else if (CHK_DAYS_STARTEND(Month.November, 6, Month.December, 31))
    {
        return 3100;
    }

    return 5350;
}

void BattleTutorials()
{
    while (true)
    {
        MSG_WND_DSP();
        MSG(SYS_TUTORIAL_FIRST);
        SEL_DEFKEY(PadButton.Circle, 4);
        int tutSel = SEL(SYS_TUTORIAL_SEL);
        MSG_WND_CLS();

        if (tutSel == 0)
        {
            FUNCTION_002D(SYS_TUTORIAL_01);
        }
        else if (tutSel == 1)
        {
            FUNCTION_002D(SYS_TUTORIAL_02);
        }
        else if (tutSel == 2)
        {
            FUNCTION_002D(SYS_TUTORIAL_03);
        }
        else if (tutSel == 3)
        {
            FUNCTION_002D(SYS_TUTORIAL_04);
        }
        else if (tutSel == 4)
        {
            return;
        }
    }
}
