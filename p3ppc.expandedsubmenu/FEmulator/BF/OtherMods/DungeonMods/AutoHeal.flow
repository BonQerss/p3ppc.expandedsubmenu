bool ally_in_party(int id)
{
    int i = 0;
    while (i < 3)
    {
        if (FUNCTION_0042(i) == id)
            return true;
        i = i + 1;
    }
    return false;
}

void heal_one(int id)
{
    int missing = GET_MAXHP(id) - GET_HP(id);
    if (missing <= 0)
        return;

    if (BIT_CHK(5154))
    {
        SET_HP(id, GET_MAXHP(id));
        return;
    }

    int cost = (missing + 3) / 4;
    if (cost > GET_SP(id))
        cost = GET_SP(id);

    SET_HP(id, GET_HP(id) + (cost * 4));
    if (GET_HP(id) > GET_MAXHP(id))
        SET_HP(id, GET_MAXHP(id));

    SET_SP(id, GET_SP(id) - cost);
}

void heal_mc()
{
    heal_one(1);
}

void heal_avail_party()
{
    int id = 2;
    while (id <= 10)
    {
        if (id != 6 && ally_in_party(id))
            heal_one(id);
        id = id + 1;
    }
}
