import("ModMenu/ModMenu.flow");
import("Setup/FirstTimeSetup.flow");
import("OtherMods/DungeonMods/OrganizeParty.flow");
import("OtherMods/DungeonMods/ClockAnywhere.flow");
import("OtherMods/DungeonMods/VRGameOverSkip.flow");
import("OtherMods/DungeonMods/SelectFloor.flow");
import("OtherMods/DungeonMods/Warp.flow");
import("field.msg");

global(22) int deadAllyCount;
global(60) int naviBup;
global(61) int itemYukariMSG;
global(62) int itemAigisMSG;
global(63) int itemMitsuruMSG;
global(64) int itemJunpeiMSG;
global(65) int itemAkihikoMSG;
global(66) int itemKenMSG;
global(67) int itemShinjiMSG;
global(68) int itemKoromaruMSG;
global(69) int itemMultipleMSG;
global(70) int itemSingleMSG;
global(71) int stayGroupMSG;
global(72) int noEnemyMSG;
global(73) int nobodyOrderMSG;
global(74) int whatOrderMSG;
global(75) int regroupMSG;
global(76) int spreadMSG;
global(77) int avoidBattleMSG;
global(79) int findBattleMSG;
global(80) int adviseReturnMSG;
global(82) int moneyMSG;
global(96) int naviCutin;

global bool isFieldBf;

void field_order_party_hook()
{
    isFieldBf = true;

    if (!BIT_CHK(5153))
    {
        FirstTimeSetup();
        return;
    }

    field_order_party_unhooked();
}

void CallOriginalSquareMenu()
{
    field_order_party();
}

void tartaros_order_party_hook()
{
    if (!BIT_CHK(5153))
    {
        FirstTimeSetup();
        return;
    }

    itemYukariMSG = ITEM_TRANSFER_YUKARI;
    itemAigisMSG = ITEM_TRANSFER_AEGIS;
    itemMitsuruMSG = ITEM_TRANSFER_MITSURU;
    itemJunpeiMSG = ITEM_TRANSFER_JUNPEI;
    itemAkihikoMSG = ITEM_TRANSFER_SANADA;
    itemKenMSG = ITEM_TRANSFER_AMADA;
    itemShinjiMSG = ITEM_TRANSFER_ARAGAKI;
    itemKoromaruMSG = ITEM_TRANSFER_KOROMARU;
    itemSingleMSG = ITEM_TRANSFER_MONO;
    itemMultipleMSG = ITEM_TRANSFER_POLY;
    moneyMSG = MONEY_TRANSFER;
    whatOrderMSG = ORDER_OK;

    if (BIT_CHK(3123))
    {
        naviCutin = 6;
        naviBup = naviCutin;
        gVar97 = 4;
        stayGroupMSG = HUKA_CANT_ORDER_BATTLE;
        noEnemyMSG = HUKA_CANT_ORDER_NO_BATTL;
        nobodyOrderMSG = HUKA_CANT_ORDER_2;
        regroupMSG = HUKA_GATHER;
        spreadMSG = HUKA_DISPERSION;
        avoidBattleMSG = HUKA_NO_BATTLE;
        findBattleMSG = HUKA_GO_BATTLE;
        adviseReturnMSG = HUKA_RETURN_ADVICE;
    }
    else
    {
        naviCutin = 4;
        naviBup = naviCutin;
        gVar97 = naviCutin;
        stayGroupMSG = MITSURU_CANT_ORDER_BATTL;
        noEnemyMSG = MITSURU_CANT_ORDER_NO_BA;
        nobodyOrderMSG = MITSURU_CANT_ORDER;
        regroupMSG = MITSURU_GATHER;
        spreadMSG = MITSURU_DISPERSION;
        avoidBattleMSG = MITSURU_NO_BATTLE;
        findBattleMSG = MITSURU_GO_BATTLE;
        adviseReturnMSG = MITSURU_RETURN_ADVICE;
    }

    int orderMask = 0;
    currentFloor = FLD_FUNCTION_0004();
    check_party_member();

    if (BIT_CHK(3571))
    {
        orderMask = orderMask + 2;
    }
    else
    {
        orderMask = orderMask + 1;
    }

    if (!BIT_CHK(3572))
    {
        orderMask = orderMask + 4;
    }
    else
    {
        orderMask = orderMask + 8;
    }

    if (BIT_CHK(3123))
    {
        if (!FLD_FUNCTION_0031(6, 339))
        {
            orderMask = orderMask + 0x20;
        }
        else
        {
            orderMask = orderMask + 0x10;
        }
    }
    else
    {
        orderMask = orderMask + 0x30;
    }

    if (!BIT_CHK(4065))
    {
        orderMask = orderMask + Power(2, 13);
    }

    if (BIT_CHK(3567) && !CurrentGuardianIsCleared())
    {
        order_stop();
        return;
    }
    else if (allyCount == deadAllyCount)
    {
        FUNCTION_0064(0, 0, 0, naviCutin, 2, 0, 0);
        MSG_WND_DSP();
        MSG(nobodyOrderMSG);
        order_for_huka();
        return;
    }
    else
    {
        MSG_WND_DSP();
        MSG(whatOrderMSG);
    }

    if (!BIT_CHK(5154))
    {
        orderMask = orderMask + Power(2, 9);
    }

    if (!BIT_CHK(5168))
    {
        orderMask = orderMask + Power(2, 7);
    }

    if (!BIT_CHK(5165))
    {
        orderMask = orderMask + Power(2, 8);
    }

    if (!BIT_CHK(5167))
    {
        orderMask = orderMask + Power(2, 6);
    }

    if (!BIT_CHK(5178))
    {
        orderMask = orderMask + Power(2, 10);
        orderMask = orderMask + Power(2, 11);
    }
    else if (!CanWarpNextFloor())
    {
        orderMask = orderMask + Power(2, 11);
    }

    SEL_DEFKEY(PadButton.Circle, 12);
    SEL_DEFKEY(PadButton.Triangle, 99);
    FUNCTION_0006(orderMask);
    int orderChoice = SEL(ORDER_SEL);
    MSG_WND_CLS();

    if (orderChoice == 0)
    {
        BIT_OFF(3571);
        FLD_FUNCTION_0013(0);
        FLD_START_SUPPORT_MSG(naviCutin, regroupMSG);
    }
    else if (orderChoice == 1)
    {
        BIT_ON(3571);
        FLD_FUNCTION_0013(1);
        FLD_START_SUPPORT_MSG(naviCutin, spreadMSG);
    }
    else if (orderChoice == 2)
    {
        BIT_ON(3572);
        FLD_FUNCTION_0014(1);
        FLD_START_SUPPORT_MSG(naviCutin, avoidBattleMSG);
    }
    else if (orderChoice == 3)
    {
        if (!BIT_CHK(3122))
        {
            BIT_ON(3122);
            FUNCTION_002D(ORDER_STANCE_HELP);
        }

        BIT_ON(3572);
        FLD_FUNCTION_0014(0);
        FLD_START_SUPPORT_MSG(naviCutin, findBattleMSG);
    }
    else if ((orderChoice == 4) || (orderChoice == 5))
    {
        FUNCTION_0064(0, 0, 0, naviCutin, 0, 0, 0);
        MSG_WND_DSP();

        if (orderChoice == 4)
        {
            order_to_change_bgm();
            return;
        }

        MSG(HUKA_ORDER);
        order_for_huka();
    }
    else if (orderChoice == 6)
    {
        MSG_WND_DSP();
        change_party();
    }
    else if (orderChoice == 7)
    {
        SelectFloor();
    }
    else if (orderChoice == 8)
    {
        try_call_clock();
    }
    else if (orderChoice == 9)
    {
        ModMenuInit();
    }
    else if (orderChoice == 10)
    {
        WarpEntrance();
    }
    else if (orderChoice == 11)
    {
        WarpNextFloor();
    }
    else if (orderChoice == 13)
    {
        debug_mode();
    }
    else if (orderChoice == 99)
    {
        MenuOptions();
    }
}

void order_for_huka_hook()
{
    if (!BIT_CHK(5153))
    {
        FirstTimeSetup();
        return;
    }

FUUKA_RESTART:
    int fuukaMask = 0;

    if (!BIT_CHK(3123))
    {
        fuukaMask = fuukaMask + 3;
    }
    else if (!FLD_FUNCTION_0031(6, 339))
    {
        fuukaMask = fuukaMask + 1;
    }

    if (!BIT_CHK(4065))
    {
        fuukaMask = fuukaMask + Power(2, 9);
    }

    if (!BIT_CHK(5168))
    {
        fuukaMask = fuukaMask + Power(2, 3);
    }

    if (!BIT_CHK(5154))
    {
        fuukaMask = fuukaMask + Power(2, 5);
    }

    if (!BIT_CHK(5165))
    {
        fuukaMask = fuukaMask + Power(2, 4);
    }

    if (!BIT_CHK(5167))
    {
        fuukaMask = fuukaMask + Power(2, 2);
    }

    if (!BIT_CHK(5178))
    {
        fuukaMask = fuukaMask + Power(2, 6);
        fuukaMask = fuukaMask + Power(2, 7);
    }
    else if (!CanWarpNextFloor())
    {
        fuukaMask = fuukaMask + Power(2, 7);
    }

    SEL_DEFKEY(PadButton.Circle, 8);
    SEL_DEFKEY(PadButton.Triangle, 99);
    FUNCTION_0006(fuukaMask);
    int fuukaOrder = SEL(HUKA_OREDER_SEL);

    if (fuukaOrder == 0)
    {
        MSG(HUKA_ORDER_ESCAPE);
        SEL_DEFKEY(PadButton.Circle, 1);

        if (BIT_CHK(4104) || FLD_FUNCTION_0046())
        {
            fuukaOrder = SEL(ESCAPE_SEL);
        }
        else
        {
            fuukaOrder = SEL(ESCAPE_SEL_G);
        }

        if (fuukaOrder == 0)
        {
            MSG(HUKA_ORDER_ESCAPE_GO);
            MSG_WND_CLS();
            FUNCTION_0065(0);
            BIT_ON(3193);
            return_to_entrance();
            return;
        }

        MSG(HUKA_ORDER_RESTART);
        goto FUUKA_RESTART;
    }
    else if (fuukaOrder == 1)
    {
        order_to_change_bgm();
        return;
    }
    else if (fuukaOrder == 2)
    {
        MSG_WND_CLS();
        FUNCTION_0065(0);
        MSG_WND_DSP();
        change_party();
        return;
    }
    else if (fuukaOrder == 3)
    {
        MSG_WND_CLS();
        FUNCTION_0065(0);
        MSG_WND_DSP();
        SelectFloor();
        return;
    }
    else if (fuukaOrder == 4)
    {
        MSG_WND_CLS();
        FUNCTION_0065(0);
        try_call_clock();
        return;
    }
    else if (fuukaOrder == 5)
    {
        MSG_WND_CLS();
        FUNCTION_0065(0);
        ModMenuInit();
        return;
    }
    else if (fuukaOrder == 6)
    {
        MSG_WND_CLS();
        FUNCTION_0065(0);
        WarpEntrance();
        return;
    }
    else if (fuukaOrder == 7)
    {
        MSG_WND_CLS();
        FUNCTION_0065(0);
        WarpNextFloor();
        return;
    }
    else if (fuukaOrder == 9)
    {
        debug_mode();
        return;
    }
    else if (fuukaOrder == 99)
    {
        MSG_WND_CLS();
        FUNCTION_0065(0);
        MenuOptions();
        return;
    }

    MSG_WND_CLS();
    FUNCTION_0065(0);
}

void try_call_clock()
{
    if (!BIT_CHK(5175) || FLD_FUNCTION_0031(6, 339))
    {
        HealingClock();
    }
    else
    {
        int numTraesto = GET_ITEM_NUM(0x500 + 33);
        MSG_WND_DSP();
        SET_MSG_VAR(0, 0x500 + 33, 5);

        if (numTraesto >= 1)
        {
            SET_MSG_VAR(1, numTraesto, 0);
            MSG(CALL_CLOCK_TRAESTO);
            SEL_DEFKEY(PadButton.Circle, 1);

            if (SEL(MISSING_PERSON_SEL) == 0)
            {
                MSG_WND_CLS();
                FUNCTION_0020(2, 20);
                FUNCTION_0010(FadeEffects.FadeOut, 5, 255, 255, 255);
                FUNCTION_000F();
                FUNCTION_000D(10);
                FUNCTION_000F();
                SET_ITEM_NUM(0x500 + 33, numTraesto - 1);
                HealingClock();
            }
        }
        else
        {
            MSG(NO_TRAESTO);
            MSG_WND_CLS();
        }
    }
}
