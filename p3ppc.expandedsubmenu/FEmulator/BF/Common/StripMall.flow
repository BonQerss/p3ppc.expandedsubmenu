import("../ModMenu/ModMenu.flow");
import("../Setup/FirstTimeSetup.flow");
import("../OtherMods/FindAFriend.flow");
import("../OtherMods/QuickTravelPlus.flow");
import("StripMall.msg");

void stripmall_shortcut()
{
    if (!BIT_CHK(5153))
    {
        FirstTimeSetup();
    }

    CurFldMinor = FLD_GET_MINOR();

    SEL_DEFKEY(PadButton.Circle, 98);
    SEL_DEFKEY(PadButton.Triangle, 99);

    if (BIT_CHK(5163) && BIT_CHK(5154) && !gQMenuNormalSquare)
    {
        ModMenuInit();
        return;
    }

    shortcut_select(MSG_SELECT(FLD_ORDER, SHOP_SHOTCUTSEL, create_stripmall_mask()));
}

void shortcut_select(int selection)
{
    if (selection <= 2)
    {
        FADE(FadeEffects.CircleWipe, 20);
        FUNCTION_000F();

        switch (selection)
        {
            case 0:
                if (GET_DAY(10, 4) && FCL_FUNCTION_001B())
                {
                    MSG_WND_DSP();
                    MSG(OUT_STOP);
                    MSG_WND_CLS();
                }
                else
                {
                    FADE(3, 20);
                    CALL_FIELD(9, 1, 1, 0);
                }
                return;
            case 1:
                if (GET_DAY(10, 4) && FCL_FUNCTION_001B())
                {
                    MSG_WND_DSP();
                    MSG(OUT_STOP);
                    MSG_WND_CLS();
                }
                else
                {
                    FADE(3, 20);
                    FUNCTION_001E(3, 0);
                    CALL_FIELD(9, 8, 0, 0);
                    return;
                }
                break;
            case 2:
                if (GET_DAY(10, 4) && FCL_FUNCTION_001B() && (CurFldMinor == 1))
                {
                    HIT_SCRIPT_01();
                }
                else
                {
                    FADE(3, 20);
                    CALL_FIELD(9, 2, 0, 0);
                    return;
                }
                break;
        }
    }
    else if (selection == 3)
    {
        if (GET_DAY(10, 4) && FCL_FUNCTION_001B())
        {
            MSG_WND_DSP();
            MSG(OUT_STOP);
            MSG_WND_CLS();
        }
        else
        {
            BIT_ON(3090);
            FADE(3, 20);
            FUNCTION_000F();
            FLD_SEL_EX(3);
            return;
        }
    }
    else if (selection == 4)
    {
        QuickTravelPlus();
    }
    else if (selection == 5)
    {
        CALL_CALENDAR();
    }
    else if (selection == 6)
    {
        HangOut();
    }
    else if (selection == 7)
    {
        FADE(FadeEffects.FadeOut, 10);
        SAVE_MENU();
        FUNCTION_000D(0);
    }
    else if (selection == 8)
    {
        ModMenuInit();
    }
    else if (selection == 99)
    {
        MenuOptions();
    }
}

int create_stripmall_mask()
{
    int mask = MaskCalc(9);

    if (!BIT_CHK(5155))
    {
        switch (CurFldMinor)
        {
            case 1:
                if (GET_DAY(10, 4) && FCL_FUNCTION_001B())
                {
                    mask = mask - Power(2, 2);
                }
                else
                {
                    mask = mask - Power(2, 1);
                    mask = mask - Power(2, 2);
                    mask = mask - Power(2, 3);
                }
                break;
            case 2:
                mask = mask - Power(2, 0);
                mask = mask - Power(2, 3);
                break;
            case 8:
                mask = mask - Power(2, 0);
                mask = mask - Power(2, 2);
                mask = mask - Power(2, 3);
                break;
            case 9:
                mask = mask - Power(2, 2);
                break;
            default:
                break;
        }
    }
    else
    {
        if (CurFldMinor == 9)
        {
            mask = mask - Power(2, 2);
        }
        else
        {
            mask = mask - Power(2, 4);
        }
    }

    if (BIT_CHK(5156))
    {
        mask = mask - Power(2, 5);
    }

    if (BIT_CHK(5158))
    {
        mask = mask - Power(2, 6);
    }

    if (BIT_CHK(5159) && !BIT_CHK(5154))
    {
        mask = mask - Power(2, 7);
    }

    if (BIT_CHK(5154))
    {
        mask = mask - Power(2, 8);
    }

    return mask;
}
