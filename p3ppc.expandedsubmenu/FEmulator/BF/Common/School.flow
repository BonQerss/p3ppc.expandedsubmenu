import("../ModMenu/ModMenu.flow");
import("../Setup/FirstTimeSetup.flow");
import("../OtherMods/FindAFriend.flow");
import("../OtherMods/QuickTravelPlus.flow");
import("../OtherMods/SaveEveryday.flow");
import("School.msg");

void school_shortcut_hook()
{
    if (!BIT_CHK(5153))
    {
        FirstTimeSetup();
    }

    if (BIT_CHK(3680))
    {
        MSG_WND_DSP();

        if (BIT_CHK(4104) || BIT_CHK(311))
        {
            MSG(STOP_2F);
        }
        else
        {
            MSG(STOP_2F_SANADA);
        }

        MSG_WND_CLS();
        return;
    }

    if (BIT_CHK(5163) && BIT_CHK(5154) && !gQMenuNormalSquare)
    {
        ModMenuInit();
        return;
    }

    shortcut_select();
    FUNCTION_003B();
}

void shortcut_select()
{
    SEL_DEFKEY(PadButton.Circle, 98);
    SEL_DEFKEY(PadButton.Triangle, 99);
    int selection = MSG_SELECT(FLD_ORDER, SCHOOL_SHOTCUTSEL, create_school_mask());

    if (selection <= 8)
    {
        FADE(FadeEffects.CircleWipe, 20);
        FUNCTION_000F();

        switch (selection)
        {
            case 0:
                CALL_FIELD(6, 1, 1, 0);
                return;
            case 1:
                CALL_FIELD(6, 7, 1, 0);
                return;
            case 2:
                CALL_FIELD(6, 11, 1, 0);
                return;
            case 3:
                CALL_FIELD(6, 0x10, 1, 0);
                return;
            case 4:
                CALL_FIELD(6, 20, 0, 0);
                return;
            case 5:
                CALL_FIELD(6, 4, 2, 0);
                return;
            case 6:
                CALL_FIELD(6, 3, 0, 0);
                return;
            case 7:
                CALL_FIELD(6, 5, 0, 0);
                return;
            case 8:
                CALL_FIELD(6, 2, 1, 0);
                return;
        }
    }
    else if (selection == 9)
    {
        get_out_here();
    }
    else if (selection == 10)
    {
        QuickTravelPlus();
    }
    else if (selection == 11)
    {
        CALL_CALENDAR();
    }
    else if (selection == 12)
    {
        HangOut();
    }
    else if (selection == 13)
    {
        FADE(FadeEffects.FadeOut, 10);
        SAVE_MENU();
        FUNCTION_000D(0);
    }
    else if (selection == 14)
    {
        ModMenuInit();
    }
    else if (selection == 99)
    {
        MenuOptions();
    }
}

int create_school_mask()
{
    int mask = 0x7FFF;

    if (!BIT_CHK(5155))
    {
        int var6 = 0;

        switch (FLD_GET_MINOR())
        {
            case 1:
                if (GET_DAY(Month.April, 7))
                {
                    var6 = var6 + 2;
                }
                else
                {
                    var6 = var6 + 614;
                }
                break;
            case 3:
                var6 = var6 + 550;
                break;
            case 4:
                var6 = var6 + 582;
                break;
            case 7:
                if (GET_DAY(Month.April, 7))
                {
                    var6 = var6 + 1;
                }
                else
                {
                    var6 = var6 + 612;
                }
                break;
            case 11:
                var6 = var6 + 610;
                break;
            case 2:
            case 5:
            case 16:
            case 20:
                var6 = var6 + 614;
                break;
        }

        mask = mask - var6;
    }
    else
    {
        mask = mask - 0x400;
    }

    if (BIT_CHK(5156))
    {
        mask = mask - 0x800;
    }

    if (BIT_CHK(5158))
    {
        mask = mask - 0x1000;
    }

    if (BIT_CHK(5159) && !BIT_CHK(5154))
    {
        mask = mask - 0x2000;
    }

    if (BIT_CHK(5154))
    {
        mask = mask - 0x4000;
    }

    return mask;
}
