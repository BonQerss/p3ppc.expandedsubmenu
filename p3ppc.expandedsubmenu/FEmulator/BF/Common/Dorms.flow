import("../ModMenu/ModMenu.flow");
import("../Setup/FirstTimeSetup.flow");
import("../OtherMods/FindAFriend.flow");
import("../OtherMods/QuickTravelPlus.flow");
import("../OtherMods/SaveEveryday.flow");
import("Dorms.msg");

void dormitory_shortcut_hook()
{
    if (!BIT_CHK(5153))
    {
        FirstTimeSetup();
    }

    if (GET_DAY(Month.April, 6) || GET_DAY(Month.April, 9))
    {
        MSG_WND_DSP();
        MSG(FIRST_DAY);
        MSG_WND_CLS();
        return;
    }

    CurFldMinor = FLD_GET_MINOR();

    SEL_DEFKEY(PadButton.Circle, 98);
    SEL_DEFKEY(PadButton.Triangle, 99);

    if (BIT_CHK(5163) && BIT_CHK(5154) && !gQMenuNormalSquare)
    {
        ModMenuInit();
        return;
    }

    shortcut_select(MSG_SELECT(FLD_ORDER, DORMITORY_SHOTCUTSEL, create_dorm_mask()));
}

void shortcut_select(int selection)
{
    if (selection <= 4)
    {
        FADE(FadeEffects.CircleWipe, 20);
        FUNCTION_000F();

        switch (selection)
        {
            case 0:
                CALL_FIELD(7, 2, 1, 0);
                return;
            case 1:
                CALL_FIELD(7, 3, 0, 0);
                return;
            case 2:
                CALL_FIELD(7, 4, 0, 0);
                return;
            case 3:
                if (BIT_CHK(3592))
                {
                    call_sees_event();
                }
                else
                {
                    CALL_FIELD(7, 5, 0, 0);
                }
                return;
            case 4:
                CALL_FIELD(7, 6, 0, 0);
                return;
        }
    }
    else if (selection == 5)
    {
        call_midnight_myroom();
    }
    else if (selection == 6)
    {
        myroom_mybed();
    }
    else if (selection == 7)
    {
        gVar140 = 0;
        goout_dormitory();
    }
    else if (selection == 8)
    {
        QuickTravelPlus();
    }
    else if (selection == 9)
    {
        CALL_CALENDAR();
    }
    else if (selection == 10)
    {
        HangOut();
    }
    else if (selection == 11)
    {
        FADE(FadeEffects.FadeOut, 10);
        SAVE_MENU();
        FUNCTION_000D(0);
    }
    else if (selection == 12)
    {
        ModMenuInit();
    }
    else if (selection == 99)
    {
        MenuOptions();
    }
}

void call_sees_event()
{
    BIT_OFF(3592);
    CALL_EVENT(129, 1);
    EVT_FUNCTION_0004(1);
    BIT_ON(21);
    CALL_DARK_HOUR();
    FCL_FUNCTION_0017();
    CALL_EVENT(130, 1);
    BIT_ON(22);
    BIT_ON(2562);
    FCL_FUNCTION_0018();
    NEXT_TIME();
}

void dorm_quick_travel()
{
    int qtMask = 0;

    if (!BIT_CHK(3592))
    {
        if (!BIT_CHK(21) || (FUNCTION_0030() == 3) || (CurFldMinor == 6))
        {
            qtMask = qtMask + 0x10;
        }

        switch (CurFldMinor)
        {
            case 2:
                qtMask = qtMask + 1;
                break;
            case 3:
                qtMask = qtMask + 2;
                break;
            case 4:
                qtMask = qtMask + 4;
                break;
            case 5:
                qtMask = qtMask + 8;
                break;
            case 9:
                qtMask = qtMask + 0x40;
                break;
            case 19:
            case 20:
                qtMask = qtMask + 0x20;
                break;
            default:
                break;
        }
    }
    else
    {
        qtMask = qtMask + 119;
    }

    SEL_DEFKEY(PadButton.Circle, 8);
    int qtSel = MSG_SELECT(QuickTravelPlus_Text, DORMITORY_QTSEL, qtMask);

    if (qtSel <= 4)
    {
        FADE(FadeEffects.CircleWipe, 20);
        FUNCTION_000F();

        switch (qtSel)
        {
            case 0:
                CALL_FIELD(7, 2, 1, 0);
                return;
            case 1:
                CALL_FIELD(7, 3, 0, 0);
                return;
            case 2:
                CALL_FIELD(7, 4, 0, 0);
                return;
            case 3:
                if (BIT_CHK(3592))
                {
                    call_sees_event();
                }
                else
                {
                    CALL_FIELD(7, 5, 0, 0);
                }
                return;
            case 4:
                CALL_FIELD(7, 6, 0, 0);
                return;
        }
    }
    else if (qtSel == 5)
    {
        call_midnight_myroom();
    }
    else if (qtSel == 6)
    {
        gVar140 = 1;
        goout_dormitory();
    }
    else if (qtSel == 7)
    {
        ElseWhere();
    }
}

int create_dorm_mask()
{
    int mask = 0x1FFF;

    if (!BIT_CHK(5155))
    {
        switch (CurFldMinor)
        {
            case 2:
                if (BIT_CHK(21) && (FUNCTION_0030() != 3))
                {
                    mask = mask - 182;
                }
                else if (BIT_CHK(3592))
                {
                    mask = mask - 136;
                }
                else
                {
                    mask = mask - 174;
                }
                break;
            case 3:
                if (BIT_CHK(21) && (FUNCTION_0030() != 3))
                {
                    mask = mask - 181;
                }
                else
                {
                    mask = mask - 173;
                }
                break;
            case 4:
                if (BIT_CHK(21) && (FUNCTION_0030() != 3))
                {
                    mask = mask - 179;
                }
                else
                {
                    mask = mask - 171;
                }
                break;
            case 5:
            case 6:
                mask = mask - 167;
                break;
            case 19:
            case 20:
                if (BIT_CHK(21) && (FUNCTION_0030() != 3))
                {
                    mask = mask - 213;
                }
                else
                {
                    mask = mask - 205;
                }
                break;
            default:
                break;
        }
    }
    else
    {
        mask = mask - 0x100;

        if ((CurFldMinor == 19) || (CurFldMinor == 20))
        {
            mask = mask - 0x40;
        }
    }

    if (BIT_CHK(5156))
    {
        mask = mask - 0x200;
    }

    if (BIT_CHK(5158))
    {
        mask = mask - 0x400;
    }

    if (BIT_CHK(5159) && !BIT_CHK(5154))
    {
        mask = mask - 0x800;
    }

    if (BIT_CHK(5154))
    {
        mask = mask - 0x1000;
    }

    return mask;
}
