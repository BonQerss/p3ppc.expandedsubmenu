import("../ModMenu/ModMenu.flow");
import("../Setup/FirstTimeSetup.flow");
import("../OtherMods/FindAFriend.flow");
import("../OtherMods/QuickTravelPlus.flow");
import("../OtherMods/SaveEveryday.flow");
import("Mall.msg");

void mall_shortcut()
{
    if (!BIT_CHK(5153))
    {
        FirstTimeSetup();
    }

    CurFldMinor = FLD_GET_MINOR();

    SEL_DEFKEY(PadButton.Circle, 98);
    SEL_DEFKEY(PadButton.Triangle, 99);

    if (BIT_CHK(5163) && BIT_CHK(5154) && !gQMenuNormalSquare)
    {
        ModMenuInit();
        return;
    }

    shortcut_select(MSG_SELECT(FLD_ORDER, MALL_SHORTCUT_SEL, create_mall_mask()));
}

void shortcut_select(int selection)
{
    if (selection <= 6)
    {
        FADE(FadeEffects.CircleWipe, 20);
        FUNCTION_000F();

        switch (selection)
        {
            case 0:
                BIT_ON(5127);
                CALL_WEAPON_SHOP();
                BIT_OFF(5127);
                CALL_FIELD(8, 1, 4, 0);
                return;
            case 1:
                BIT_ON(5127);
                CALL_ITEM_SHOP();
                BIT_OFF(5127);
                CALL_FIELD(8, 1, 8, 0);
                return;
            case 2:
                FADE(3, 20);
                FUNCTION_001E(3, 3);
                BIT_ON(5127);
                CALL_TRADE_SHOP();
                BIT_OFF(5127);
                CALL_FIELD(8, 1, 7, 0);
                return;
            case 3:
                FADE(3, 20);
                FUNCTION_001E(3, 3);
                CALL_FIELD(8, 2, 0, 0);
                return;
            case 4:
                if (BIT_CHK(29) && CHK_DAYS_STARTEND(4, 22, 1, 31))
                {
                    FADE(3, 20);
                    CALL_FIELD(8, 10, 1, 0);
                }
                else
                {
                    FADE(3, 20);
                    CALL_FIELD(8, 9, 0, 0);
                }
                return;
            case 5:
                FADE(3, 20);
                CALL_FIELD(8, 1, 1, 0);
                return;
            case 6:
                FUNCTION_0010(1, 15, 255, 255, 255);
                FUNCTION_001E(3, 8);
                BIT_ON(3072);

                if (BIT_CHK(312))
                {
                    CALL_FIELD(8, 18, 0, 0);
                }
                else
                {
                    CALL_FIELD(8, 17, 0, 0);
                }
                return;
        }
    }
    else if (selection == 7)
    {
        BIT_ON(3091);
        FADE(3, 20);
        FLD_SEL_EX(1);
    }
    else if (selection == 8)
    {
        QuickTravelPlus();
    }
    else if (selection == 9)
    {
        CALL_CALENDAR();
    }
    else if (selection == 10)
    {
        HangOut();
    }
    else if (selection == 11)
    {
        FADE(FadeEffects.FadeOut, 10);
        SAVE_MENU();
        FUNCTION_000D(0);
    }
    else if (selection == 12)
    {
        ModMenuInit();
    }
    else if (selection == 99)
    {
        MenuOptions();
    }
}

int create_mall_mask()
{
    int mask = MaskCalc(13);

    if (!BIT_CHK(5155))
    {
        switch (CurFldMinor)
        {
            case 1:
                if (GET_DAY(9, 5) && FCL_FUNCTION_001B())
                {
                    mask = mask - Power(2, 3);
                }
                else if (GET_DAY(4, 22) && !BIT_CHK(257) && (FUNCTION_0033() == 3))
                {
                    mask = mask - Power(2, 0);
                    mask = mask - Power(2, 7);
                }
                else if (CHK_DAYS_STARTEND(3, 1, 3, 5) == 1)
                {
                    mask = mask - Power(2, 4);
                    mask = mask - Power(2, 7);
                }
                else if (FUNCTION_0033() == 5)
                {
                    mask = mask - Power(2, 3);
                    mask = mask - Power(2, 4);
                    mask = mask - Power(2, 6);
                    mask = mask - Power(2, 7);
                }
                else
                {
                    mask = mask - Power(2, 4);
                    mask = mask - Power(2, 6);
                    mask = mask - Power(2, 7);
                }
                break;
            case 2:
                mask = mask - Power(2, 3);
                mask = mask - Power(2, 4);
                mask = mask - Power(2, 5);
                mask = mask - Power(2, 6);
                mask = mask - Power(2, 7);
                break;
            case 9:
                if (FUNCTION_0033() != 5)
                {
                    mask = mask - Power(2, 5);
                    mask = mask - Power(2, 7);
                }
                else
                {
                    mask = mask - Power(2, 3);
                    mask = mask - Power(2, 5);
                    mask = mask - Power(2, 7);
                }
                break;
            case 10:
                if (FUNCTION_0033() != 5)
                {
                    mask = mask - Power(2, 5);
                    mask = mask - Power(2, 6);
                    mask = mask - Power(2, 7);
                }
                else
                {
                    mask = mask - Power(2, 3);
                    mask = mask - Power(2, 5);
                    mask = mask - Power(2, 6);
                    mask = mask - Power(2, 7);
                }
                break;
            default:
                break;
        }
    }
    else
    {
        mask = mask - Power(2, 8);
    }

    if (BIT_CHK(5156))
    {
        mask = mask - Power(2, 9);
    }

    if (BIT_CHK(5158))
    {
        mask = mask - Power(2, 10);
    }

    if (BIT_CHK(5159) && !BIT_CHK(5154))
    {
        mask = mask - Power(2, 11);
    }

    if (BIT_CHK(5154))
    {
        mask = mask - Power(2, 12);
    }

    return mask;
}
