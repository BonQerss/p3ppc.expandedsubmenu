import("../ModMenu/ModMenu.flow");
import("../Setup/FirstTimeSetup.flow");
import("../OtherMods/FindAFriend.flow");
import("../OtherMods/QuickTravelPlus.flow");
import("../OtherMods/SaveEveryday.flow");
import("Shrine.msg");

void shrine_shortcut()
{
    if (!BIT_CHK(5153))
    {
        FirstTimeSetup();
    }

    if (BIT_CHK(5163) && BIT_CHK(5154) && !gQMenuNormalSquare)
    {
        ModMenuInit();
    }
    else
    {
        shortcut_select();
    }
}

void shortcut_select()
{
    SEL_DEFKEY(PadButton.Circle, 98);
    SEL_DEFKEY(PadButton.Triangle, 99);
    int selection = MSG_SELECT(FLD_ORDER, TEMPLE_SHOTCUTSEL, create_shrine_mask());

    if (selection == 0)
    {
        HIT_SCRIPT_00();
    }
    else if (selection == 1)
    {
        QuickTravelPlus();
    }
    else if (selection == 2)
    {
        CALL_CALENDAR();
    }
    else if (selection == 3)
    {
        HangOut();
    }
    else if (selection == 4)
    {
        FADE(FadeEffects.FadeOut, 10);
        SAVE_MENU();
        FUNCTION_000D(0);
    }
    else if (selection == 5)
    {
        ModMenuInit();
    }
    else if (selection == 99)
    {
        MenuOptions();
    }
}

int create_shrine_mask()
{
    int mask = MaskCalc(6);

    if (!BIT_CHK(5155))
    {
        mask = mask - Power(2, 0);
    }
    else
    {
        mask = mask - Power(2, 1);
    }

    if (BIT_CHK(5156))
    {
        mask = mask - Power(2, 2);
    }

    if (BIT_CHK(5158))
    {
        mask = mask - Power(2, 3);
    }

    if (BIT_CHK(5159) && !BIT_CHK(5154))
    {
        mask = mask - Power(2, 4);
    }

    if (BIT_CHK(5154))
    {
        mask = mask - Power(2, 5);
    }

    return mask;
}
