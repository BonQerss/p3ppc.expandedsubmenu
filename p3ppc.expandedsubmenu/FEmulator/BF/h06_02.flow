import("Common/School.flow");
import("h06_02.msg");

global bool isFieldBf;

void f006_002_shortcut_hook()
{
    isFieldBf = false;

    if (BIT_CHK(3119))
    {
        if (!BIT_CHK(5153))
        {
            FirstTimeSetup();
        }

        int schoolMask = 0x3C;

        if (BIT_CHK(5156))
        {
            schoolMask = schoolMask - 4;
        }

        if (BIT_CHK(5158))
        {
            schoolMask = schoolMask - 8;
        }

        if (BIT_CHK(5159) && !BIT_CHK(5154))
        {
            schoolMask = schoolMask - 0x10;
        }

        if (BIT_CHK(5154))
        {
            schoolMask = schoolMask - 0x20;
        }

        SEL_DEFKEY(PadButton.Circle, 6);
        SEL_DEFKEY(PadButton.Triangle, 99);
        int schoolSel = MSG_SELECT(FLD_ORDER_02, SCHOOL_SHOTCUTSEL_02, schoolMask);

        if (schoolSel == 0)
        {
            HIT_SCRIPT_01();
        }
        else if (schoolSel == 1)
        {
            HIT_SCRIPT_00();
        }
        else if (schoolSel == 2)
        {
            CALL_CALENDAR();
        }
        else if (schoolSel == 3)
        {
            HangOut();
        }
        else if (schoolSel == 4)
        {
            FADE(FadeEffects.FadeOut, 10);
            SAVE_MENU();
            FUNCTION_000D(0);
        }
        else if (schoolSel == 5)
        {
            ModMenuInit();
        }
        else if (schoolSel == 99)
        {
            MenuOptions();
        }

        return;
    }

    school_shortcut();
}

void CallOriginalSquareMenu()
{
    f006_002_shortcut();
}
