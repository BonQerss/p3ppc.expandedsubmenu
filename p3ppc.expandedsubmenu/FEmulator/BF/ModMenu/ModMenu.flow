import("Utilities.flow");
import("../Setup/FirstTimeSetup.flow");
import("../OtherMods/TravelCore.flow");
import("ModMenu.msg");

global int gFieldMajor;
global int gFieldMinor;
global int gEventMajor;
global int gEventMinor;
global int gCountId;
global int gDateMonth;
global int gDateDay;
global bool isPC;
global bool gQMenuNormalSquare;

bool QMenuBackOrOptions(int selection)
{
    if (selection == 998)
    {
        MenuOptions();
        return true;
    }

    return false;
}

void ModMenuInit()
{
    isPC = true;

    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        SEL_DEFKEY(PadButton.Triangle, 998);
        int selection = MSG_SELECT(ModMenuName, ModMenu, 0);

        if (selection == 999)
            return;

        if (QMenuBackOrOptions(selection))
            continue;

        if (selection == 0)
        {
            gQMenuNormalSquare = true;
            CallOriginalSquareMenu();
            gQMenuNormalSquare = false;
            return;
        }
        else if (selection == 1)
            PlayerTools();
        else if (selection == 2)
            WorldTools();
        else if (selection == 3)
            BattleTools();
        else if (selection == 4)
            DebugTools();
    }
}

void PlayerTools()
{
    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        SEL_DEFKEY(PadButton.Triangle, 998);
        int selection = MSG_SELECT(ModMenuName, PlayerToolsMenu, 0);

        if (selection == 999)
            return;

        if (QMenuBackOrOptions(selection))
            continue;

        if (selection == 0) PartyEditorDisplay();
        else if (selection == 1) SocialLinkEditor();
        else if (selection == 2) StatEditorDisplay();
        else if (selection == 3) ItemEditorDisplay();
        else if (selection == 4) MaxMoney();
        else if (selection == 5) HealAllFree();
        else if (selection == 6) SetProtagonistName();
        else if (selection == 7) EvolvePartyPersona();
    }
}

void WorldTools()
{
    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        SEL_DEFKEY(PadButton.Triangle, 998);
        int selection = MSG_SELECT(ModMenuName, WorldToolsMenu, 0);

        if (selection == 999)
            return;

        if (QMenuBackOrOptions(selection))
            continue;

        if (selection == 0) FieldSelect();
        else if (selection == 1) EventSelect();
        else if (selection == 2) TimeTravelEditor();
        else if (selection == 3) CALL_CALENDAR();
        else if (selection == 4) FLD_SEL_EX(0);
    }
}

void BattleTools()
{
    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        SEL_DEFKEY(PadButton.Triangle, 998);
        int selection = MSG_SELECT(ModMenuName, BattleToolsMenu, 0);

        if (selection == 999)
            return;

        if (QMenuBackOrOptions(selection))
            continue;

        if (selection == 0) CallBattleManual();
        else if (selection == 1) GuardianBattleSelect();
        else if (selection == 2) BossBattleSelect();
        else if (selection == 3) EnableAllGuardians();
        else if (selection == 4) EnableAllWarps();
    }
}

void DebugTools()
{
    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        SEL_DEFKEY(PadButton.Triangle, 998);
        int selection = MSG_SELECT(ModMenuName, DebugToolsMenu, 0);

        if (selection == 999)
            return;

        if (QMenuBackOrOptions(selection))
            continue;

        if (selection == 0) FlagsEditorDisplay();
        else if (selection == 1) CountEditorDisplay();
        else if (selection == 2) AchievementEditor();
        else if (selection == 3) CallFacilityDisplay();
        else if (selection == 4) SetUpFavorites();
        else if (selection == 5) SoundTest();
    }
}

void SoundTest()
{
    int bgmId = SelectNumberPrompt(SelectBgmDialog, 5);
    if (bgmId != -1)
        BGM(bgmId);
}

void MaxMoney()
{
    ADD_PC_MONEY(99999999);
    DisplayMessagePrompt(MoneyAdded);
}

void HealAllFree()
{
    int unit = 1;

    while (unit <= 10)
    {
        if (unit != 6)
        {
            SET_HP(unit, GET_MAXHP(unit));
            SET_SP(unit, GET_MAXSP(unit));
        }

        unit = unit + 1;
    }

    DisplayMessagePrompt(FreeHealDone);
}

void SetProtagonistName()
{
    int major = FLD_GET_MAJOR();
    int minor = FLD_GET_MINOR();
    CALL_NAME_ENTRY();
    SafeCallField(major, minor, 0, 0);
}

void EvolvePartyPersona()
{
    int unit = SelectUnitNoProtagNoFuuka();
    if (unit != -1)
        PERSONA_EVOLUTION(unit);
}

void AchievementEditor()
{
    int page = 0;

    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection;

        if (page == 0) selection = MSG_SELECT(AchievementPage1Title, AchievementPage1, 0);
        else if (page == 1) selection = MSG_SELECT(AchievementPage2Title, AchievementPage2, 0);
        else if (page == 2) selection = MSG_SELECT(AchievementPage3Title, AchievementPage3, 0);
        else if (page == 3) selection = MSG_SELECT(AchievementPage4Title, AchievementPage4, 0);
        else if (page == 4) selection = MSG_SELECT(AchievementPage5Title, AchievementPage5, 0);
        else if (page == 5) selection = MSG_SELECT(AchievementPage6Title, AchievementPage6, 0);
        else if (page == 6) selection = MSG_SELECT(AchievementPage7Title, AchievementPage7, 0);
        else if (page == 7) selection = MSG_SELECT(AchievementPage8Title, AchievementPage8, 0);
        else selection = MSG_SELECT(AchievementPage9Title, AchievementPage9, 0);

        if (selection == 999)
            return;

        if (selection >= 0 && selection < 4)
        {
            int id = (page * 4) + selection;
            SET_MSG_VAR(0, id, 0);
            MSG_WND_DSP();
            MSG(AchievementWarning);
            SEL_DEFKEY(PadButton.Circle, 1);
            if (SEL(AchievementConfirm) == 0)
                HD_FUNCTION_0067(id, 0);
            MSG_WND_CLS();
        }
        else if (selection == 4)
        {
            if (page < 8)
                page = page + 1;
            else
                page = page - 1;
        }
        else if (selection == 5)
        {
            if (page == 0 || page == 8)
                return;
            page = page - 1;
        }
    }
}

void SocialLinkEditor()
{
    while (true)
    {
        int link = SelectSLink();

        if (link == -1)
            return;

        SET_MSG_VAR(1, link, 0);
        SET_MSG_VAR(2, CMM_GET_LV(link), 0);
        MSG_WND_DSP();
        MSG(SocialLinkCurrent);
        MSG_WND_CLS();

        int rank = SelectNumberPrompt(CommuPrompt, 2);

        if (rank == -1)
            continue;

        if (rank > 10)
            rank = 10;

        SetSocialLinkRank(link, rank);
        SET_MSG_VAR(1, link, 0);
        SET_MSG_VAR(2, CMM_GET_LV(link), 0);
        DisplayMessagePrompt(SocialLinkChanged);
    }
}

void SetSocialLinkRank(int link, int rank)
{
    CMM_SET_LV(link, rank, 0);
}

void PartyEditorDisplay()
{
    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection = MSG_SELECT(ModMenuName, PartyEditMenu, 0);

        if (selection == 999)
            return;

        int unit;

        if (selection == 0)
        {
            unit = SelectUnitNoProtagNoFuuka();
            if (unit != -1) PARTY_IN(unit);
        }
        else if (selection == 1)
        {
            unit = SelectUnitNoProtagNoFuuka();
            if (unit != -1) PARTY_OUT(unit);
        }
        else if (selection == 2)
            SetTiredness();
    }
}

void SetTiredness()
{
    int unit = SelectUnit();

    if (unit == -1)
        return;

    SEL_DEFKEY(PadButton.Circle, 999);
    int selection = MSG_SELECT(ModMenuName, SetTiredness, 0);

    if (selection == 0) SET_TIREDNESS(unit, 2);
    else if (selection == 1) SET_TIREDNESS(unit, 0);
    else if (selection == 2) SET_TIREDNESS(unit, 3);
}

void StatEditorDisplay()
{
    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection = MSG_SELECT(ModMenuName, StatsMenu, 0);

        if (selection == 999)
            return;

        int amount = SelectNumberPrompt(StatPrompt, 2);

        if (amount != -1 && selection >= 0 && selection <= 2)
            ADD_PC_STAT(selection, amount);
    }
}

void ItemEditorDisplay()
{
    int itemId = SelectNumberPrompt(ItemPrompt, 4);

    if (itemId == -1)
        return;

    int amount = SelectNumberPrompt(ItemPrompt2, 2);

    if (amount == -1)
        return;

    SET_ITEM_NUM(itemId, GET_ITEM_NUM(itemId) + amount);
    SET_MSG_VAR(1, itemId, 5);
    SET_MSG_VAR(2, amount, 0);
    DisplayMessagePrompt(ItemAdded);
}

void CountEditorDisplay()
{
    while (true)
    {
        SET_MSG_VAR(1, gCountId, 0);
        SET_MSG_VAR(2, GET_COUNT(gCountId), 0);
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection = MSG_SELECT(ModMenuName, CountSelect, 0);

        if (selection == 999)
            return;

        if (selection == 0)
        {
            int id = SelectNumberPrompt(CountDlg, 4);
            if (id != -1)
                gCountId = id;
        }
        else if (selection == 1)
        {
            SET_MSG_VAR(1, gCountId, 0);
            SET_MSG_VAR(2, GET_COUNT(gCountId), 0);
            int value = SelectNumberPrompt(CountDlg2, 4);
            if (value != -1)
                SET_COUNT(gCountId, value);
        }
    }
}

void FieldSelect()
{
    while (true)
    {
        SET_MSG_VAR(1, FLD_GET_MAJOR(), 0);
        SET_MSG_VAR(2, FLD_GET_MINOR(), 0);
        SET_MSG_VAR(3, gFieldMajor, 0);
        SET_MSG_VAR(4, gFieldMinor, 0);
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection = MSG_SELECT(ModMenuName, FieldSelectMenu, 0);

        if (selection == 999)
            return;

        if (selection == 0)
        {
            int major = SelectNumberPrompt(FieldDlg, 3);
            if (major == -1) continue;
            int minor = SelectNumberPrompt(FieldDlg2, 3);
            if (minor == -1) continue;
            gFieldMajor = major;
            gFieldMinor = minor;
        }
        else if (selection == 1)
        {
            if (gFieldMajor == 0 && gFieldMinor == 0)
                DisplayMessagePrompt(LoadCheckError);
            else
                SafeCallField(gFieldMajor, gFieldMinor, 0, 0);
        }
        else if (selection == 2)
        {
            if (gFieldMajor == 0 && gFieldMinor == 0)
                DisplayMessagePrompt(LoadCheckError);
            else
                FCL_FUNCTION_0015(gFieldMajor, gFieldMinor, 0, 0);
        }
        else if (selection == 3)
        {
            gFieldMajor = FLD_GET_MAJOR();
            gFieldMinor = FLD_GET_MINOR();
        }
    }
}

void EventSelect()
{
    while (true)
    {
        SET_MSG_VAR(1, gEventMajor, 0);
        SET_MSG_VAR(2, gEventMinor, 0);
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection = MSG_SELECT(ModMenuName, EventSelectMenu, 0);

        if (selection == 999)
            return;

        if (selection == 0)
        {
            int major = SelectNumberPrompt(EventDlg, 3);
            if (major == -1) continue;
            int minor = SelectNumberPrompt(EventDlg2, 3);
            if (minor == -1) continue;
            gEventMajor = major;
            gEventMinor = minor;
        }
        else if (selection == 1)
        {
            if (gEventMajor == 0 && gEventMinor == 0)
            {
                DisplayMessagePrompt(LoadCheckError);
                continue;
            }

            int fieldMajor = FLD_GET_MAJOR();
            int fieldMinor = FLD_GET_MINOR();
            FADE(3, 20);
            FUNCTION_000F();
            CALL_EVENT(gEventMajor, gEventMinor);
            SafeCallField(fieldMajor, fieldMinor, 0, 0);
        }
    }
}

void TimeTravelEditor()
{
    while (true)
    {
        SET_MSG_VAR(1, gDateMonth, 0);
        SET_MSG_VAR(2, gDateDay, 0);
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection = MSG_SELECT(ModMenuName, DateMenu, 0);

        if (selection == 999)
            return;

        if (selection == 0)
        {
            int month = SelectNumberPrompt(TimeTravel, 2);
            if (month == -1) continue;
            int day = SelectNumberPrompt(TimeTravel2, 2);
            if (day == -1) continue;
            gDateMonth = month;
            gDateDay = day;
        }
        else if (selection == 1)
        {
            if (gDateMonth <= 0 || gDateDay <= 0)
                DisplayMessagePrompt(LoadCheckError);
            else
            {
                FADE(3, 20);
                FUNCTION_0036(gDateMonth, gDateDay, 0);
                NEXT_TIME();
                return;
            }
        }
    }
}

void RunBattle(int encounter)
{
    int fieldMajor = FLD_GET_MAJOR();
    int fieldMinor = FLD_GET_MINOR();
    CALL_BATTLE(encounter);
    WAIT_BATTLE();
    SafeCallField(fieldMajor, fieldMinor, 0, 0);
}

void CallBattleManual()
{
    int encounter = SelectNumberPrompt(EncounterPrompt, 3);
    if (encounter != -1)
        RunBattle(encounter);
}

void GuardianBattleSelect()
{
    SEL_DEFKEY(PadButton.Circle, 999);
    int block = MSG_SELECT(GuardianBlockTitle, GuardianBlockMenu, 0);

    if (block == 999)
        return;

    GuardianBattleBlock(block);
}

void GuardianBattleBlock(int block)
{
    SEL_DEFKEY(PadButton.Circle, 999);
    int selection;

    if (block == 0) selection = MSG_SELECT(GuardianBattleTitle, GuardianBlock1, 0);
    else if (block == 1) selection = MSG_SELECT(GuardianBattleTitle, GuardianBlock2, 0);
    else if (block == 2) selection = MSG_SELECT(GuardianBattleTitle, GuardianBlock3, 0);
    else if (block == 3) selection = MSG_SELECT(GuardianBattleTitle, GuardianBlock4, 0);
    else if (block == 4) selection = MSG_SELECT(GuardianBattleTitle, GuardianBlock5, 0);
    else selection = MSG_SELECT(GuardianBattleTitle, GuardianBlock6, 0);

    if (selection == 999)
        return;

    int encounter = -1;

    if (block == 0)
    {
        if (selection == 0) encounter = 490;
        else if (selection == 1) encounter = 462;
        else if (selection == 2) encounter = 463;
    }
    else if (block == 1)
    {
        if (selection == 0) encounter = 464;
        else if (selection == 1) encounter = 465;
        else if (selection == 2) encounter = 470;
        else if (selection == 3) encounter = 471;
        else if (selection == 4) encounter = 472;
    }
    else if (block == 2)
    {
        if (selection == 0) encounter = 473;
        else if (selection == 1) encounter = 474;
        else if (selection == 2) encounter = 475;
    }
    else if (block == 3)
    {
        if (selection == 0) encounter = 476;
        else if (selection == 1) encounter = 477;
        else if (selection == 2) encounter = 478;
        else if (selection == 3) encounter = 479;
    }
    else if (block == 4)
    {
        if (selection == 0) encounter = 480;
        else if (selection == 1) encounter = 481;
        else if (selection == 2) encounter = 482;
        else if (selection == 3) encounter = 483;
        else if (selection == 4) encounter = 484;
    }
    else
    {
        if (selection == 0) encounter = 485;
        else if (selection == 1) encounter = 486;
        else if (selection == 2) encounter = 487;
        else if (selection == 3) encounter = 488;
        else if (selection == 4) encounter = 489;
    }

    if (encounter != -1)
        RunBattle(encounter);
}

void BossBattleSelect()
{
    int page = 0;

    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection;

        if (page == 0) selection = MSG_SELECT(BossPage1Title, BossPage1, 0);
        else if (page == 1) selection = MSG_SELECT(BossPage2Title, BossPage2, 0);
        else selection = MSG_SELECT(BossPage3Title, BossPage3, 0);

        if (selection == 999)
            return;

        int encounter = -1;

        if (page == 0)
        {
            if (selection >= 0 && selection <= 5) encounter = 416 + selection;
            else if (selection == 6) page = 1;
        }
        else if (page == 1)
        {
            if (selection >= 0 && selection <= 3) encounter = 422 + selection;
            else if (selection == 4) page = 2;
            else if (selection == 5) page = 0;
        }
        else
        {
            if (selection == 0) encounter = 426;
            else if (selection == 1) encounter = 427;
            else if (selection == 2) encounter = 428;
            else if (selection == 3) encounter = 430;
            else if (selection == 4) encounter = 455;
            else if (selection == 5) encounter = 453;
            else if (selection == 6) page = 1;
        }

        if (encounter != -1)
        {
            RunBattle(encounter);
            return;
        }
    }
}

void EnableAllGuardians()
{
    BIT_ON(3562);
    int i = 3536;

    while (i <= 3559)
    {
        BIT_ON(i);
        i = i + 1;
    }

    DisplayMessagePrompt(GuardiansEnabled);
}

void EnableAllWarps()
{
    int i = 3505;

    while (i <= 3518)
    {
        BIT_ON(i);
        i = i + 1;
    }

    i = 3529;
    while (i <= 3534)
    {
        BIT_ON(i);
        i = i + 1;
    }

    DisplayMessagePrompt(WarpsEnabled);
}

void CallFacilityDisplay()
{
    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection = MSG_SELECT(ModMenuName, FacilityMenu, 0);

        if (selection == 999)
            return;

        if (selection == 0)
        {
            FLD_SEL_EX(0);
            return;
        }
        else if (selection == 1)
        {
            FADE(1, 10);
            FUNCTION_000F();
            SAVE_MENU();
            FUNCTION_000D(0);
            FUNCTION_000F();
        }
        else if (selection == 2)
            CALL_COMBINE_SHOP();
        else if (selection == 3)
        {
            BIT_ON(5127);
            CALL_WEAPON_SHOP();
            BIT_OFF(5127);
        }
        else if (selection == 4)
        {
            BIT_ON(5127);
            CALL_ITEM_SHOP();
            BIT_OFF(5127);
        }
        else if (selection == 5)
        {
            BIT_ON(5127);
            CALL_TRADE_SHOP();
            BIT_OFF(5127);
        }
    }
}

void FlagsEditorDisplay()
{
    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection = MSG_SELECT(ModMenuName, FlagMenu, 0);

        if (selection == 999)
            return;

        if (selection == 0) FlagManualInput();
        else if (selection == 1) SetPartyJoinFlag(true);
        else if (selection == 2) SetPartyJoinFlag(false);
        else if (selection == 3) NavigatorEditor();
        else if (selection == 4) FlagMassEditor();
    }
}

void SetPartyJoinFlag(bool enabled)
{
    int unit = SelectUnitNoProtagNoFuuka();

    if (unit == -1)
        return;

    int flag = 333 + unit;

    if (enabled) BIT_ON(flag);
    else BIT_OFF(flag);

    if (unit == 4)
    {
        if (enabled) BIT_ON(82);
        else BIT_OFF(82);
    }
}

void NavigatorEditor()
{
    int i = 0;
    while (i < 32)
    {
        SET_MSG_VAR(i, i, 4);
        i = i + 1;
    }

    SEL_DEFKEY(PadButton.Circle, 999);
    int selection = MSG_SELECT(ModMenuName, NaviMenu, 0);

    if (selection == 0)
    {
        BIT_OFF(4887);
        BIT_OFF(321);
    }
    else if (selection == 1)
    {
        BIT_OFF(4887);
        BIT_ON(321);
    }
    else if (selection == 2)
        BIT_ON(4887);
}

void FlagManualInput()
{
    int id = SelectNumberPrompt(SelectFlagDialog, 4);

    if (id == -1)
        return;

    SET_MSG_VAR(1, id, 0);
    int selection = SelectOnOffCheck();

    if (selection == 0)
    {
        BIT_ON(id);
        DisplayMessagePrompt(FlagOn);
    }
    else if (selection == 1)
    {
        BIT_OFF(id);
        DisplayMessagePrompt(FlagOff);
    }
    else if (selection == 2)
    {
        if (BIT_CHK(id)) DisplayMessagePrompt(FlagCheckOn);
        else DisplayMessagePrompt(FlagCheckOff);
    }
}

void FlagMassEditor()
{
    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection = MSG_SELECT(ModMenuName, FlagMassMenu, 0);

        if (selection == 999)
            return;

        if (selection == 0) SetAllFlags(false);
        else if (selection == 1) SetAllFlags(true);
        else if (selection == 2) CompleteAllQuests();
        else if (selection == 3) EnableAllGuardians();
        else if (selection == 4) EnableAllWarps();
        else if (selection == 5) InvertAllFlags();
        else if (selection == 6) ToggleFlagRange();
    }
}

void SetAllFlags(bool enabled)
{
    int i = 0;

    while (i < 0x1600)
    {
        if (enabled) BIT_ON(i);
        else BIT_OFF(i);
        i = i + 1;
    }
}

void CompleteAllQuests()
{
    int i = 4465;

    while (i < 4563)
    {
        if (i != 4548 && (i > 4542 || i < 4525))
            BIT_ON(i);
        i = i + 1;
    }
}

void InvertAllFlags()
{
    int i = 0;

    while (i < 0x1600)
    {
        if (BIT_CHK(i)) BIT_OFF(i);
        else BIT_ON(i);
        i = i + 1;
    }
}

void ToggleFlagRange()
{
    int start = SelectNumberPrompt(FlagRangePrompt, 4);
    if (start == -1) return;
    int end = SelectNumberPrompt(FlagRangePrompt2, 4);
    if (end == -1) return;
    int state = SelectOnOff();

    if (state != 0 && state != 1)
        return;

    int i = start;
    while (i <= end)
    {
        if (state == 0) BIT_ON(i);
        else BIT_OFF(i);
        i = i + 1;
    }
}
