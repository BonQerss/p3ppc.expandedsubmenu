int Power(int number, int power)
{
    int result = 1;
    int i = 0;

    while (i < power)
    {
        result = result * number;
        i = i + 1;
    }

    return result;
}

int MaskCalc(int numberIndexes)
{
    int result = 0;
    int i = 0;

    while (i < numberIndexes)
    {
        result = result + Power(2, i);
        i = i + 1;
    }

    return result;
}
