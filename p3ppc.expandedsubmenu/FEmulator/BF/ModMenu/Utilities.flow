void DisplayMessagePrompt(int messageId)
{
    MSG_WND_DSP();
    MSG(messageId);
    MSG_WND_CLS();
}

int SelectNumberPrompt(int messageId, int digits)
{
    MSG_WND_DSP();
    MSG(messageId);
    MSG_WND_CLS();
    gNumberMenuTitle = messageId;
    int result = SelectNumber(digits);
    gNumberMenuTitle = 0;
    return result;
}

int Select10NumberPrompt(int messageId)
{
    MSG_WND_DSP();
    MSG(messageId);
    MSG_WND_CLS();
    gNumberMenuTitle = messageId;
    int result = Select10Number();
    gNumberMenuTitle = 0;
    return result;
}

