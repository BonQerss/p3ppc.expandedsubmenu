import("Utilities.msg");

global int gNumberMenuTitle;

int NumberMenuTitle()
{
    if (gNumberMenuTitle != 0)
        return gNumberMenuTitle;
    return ModMenuName;
}

int SelectDigit()
{
    int page = 0;

    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        SEL_DEFKEY(PadButton.Triangle, 998);

        int digit;

        if (page == 0)
            digit = MSG_SELECT(NumberMenuTitle(), Select0to4Dialog, 0);
        else
            digit = MSG_SELECT(NumberMenuTitle(), Select5to9Dialog, 0);

        if (digit == 999)
            return -1;

        if (digit == 998)
            return 998;

        if (page == 0)
        {
            if (digit >= 0 && digit < 5)
                return digit;

            if (digit == 5)
                page = 1;
        }
        else
        {
            if (digit >= 0 && digit < 5)
                return digit + 5;

            if (digit == 5)
                page = 0;
        }
    }

    return -1;
}

int SelectNumber(int digitCount)
{
    int number = 0;
    int i = 0;

    while (i < digitCount)
    {
        int digit = SelectDigit();

        if (digit == -1)
        {
            if (i == 0)
                return -1;
            return number;
        }

        if (digit == 998)
            return NumberSelectFavorites();

        number = number * 10;
        number = number + digit;
        i = i + 1;
    }

    return number;
}

int NumberSelectFavorites()
{
    int page = 0;

    while (true)
    {
        int start = 24 + (page * 6);
        int i = 0;

        while (i < 6)
        {
            SET_MSG_VAR(i + 1, GET_COUNT(start + i), 0);
            i = i + 1;
        }

        SEL_DEFKEY(PadButton.Circle, 999);
        if (page < 2)
            SEL_DEFKEY(PadButton.R, 996);
        if (page > 0)
            SEL_DEFKEY(PadButton.L, 997);

        int selection;

        if (page == 0)
            selection = MSG_SELECT(FavoritesName, SelectFavorites, 0);
        else if (page == 1)
            selection = MSG_SELECT(FavoritesName, SelectFavorites1, 0);
        else
            selection = MSG_SELECT(FavoritesName, SelectFavorites2, 0);

        if (selection == 999)
            return -1;

        if (selection >= 0 && selection < 6)
            return GET_COUNT(start + selection);

        if (selection == 996 && page < 2)
            page = page + 1;
        else if (selection == 997 && page > 0)
            page = page - 1;
    }

    return -1;
}

int Select10Number()
{
    int page = 0;

    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection;

        if (page == 0)
            selection = MSG_SELECT(NumberMenuTitle(), Select1to5Dialog, 0);
        else
            selection = MSG_SELECT(NumberMenuTitle(), Select6to10Dialog, 0);

        if (selection == 999)
            return -1;

        if (page == 0)
        {
            if (selection >= 0 && selection < 5)
                return selection + 1;

            if (selection == 5)
                page = 1;
        }
        else
        {
            if (selection >= 0 && selection < 5)
                return selection + 6;

            if (selection == 5)
                page = 0;
        }
    }

    return -1;
}

int SelectUnit()
{
    int i = 0;

    while (i < 32)
    {
        SET_MSG_VAR(i, i, 4);
        i = i + 1;
    }

    int page = 0;

    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection;

        if (page == 0)
            selection = MSG_SELECT(ModMenuName, UnitSelect1, 0);
        else
            selection = MSG_SELECT(ModMenuName, UnitSelect2, 0);

        if (selection == 999)
            return -1;

        if (selection >= 0 && selection < 5)
            return selection + 1 + (page * 5);

        if (selection == 5)
        {
            if (page == 0)
                page = 1;
            else
                page = 0;
        }
    }

    return -1;
}

int SelectUnitNoProtag()
{
    int unit = SelectUnit();

    if (unit == PartyMember.Protagonist)
        return -1;

    return unit;
}

int SelectUnitNoProtagNoFuuka()
{
    int unit = SelectUnitNoProtag();

    if (unit == PartyMember.Fuuka)
        return -1;

    return unit;
}

int SelectSLink()
{
    int page = 0;

    while (true)
    {
        SEL_DEFKEY(PadButton.Circle, 999);
        int selection;

        if (page == 0)
            selection = MSG_SELECT(CommuDesc, CommuCharSel1, 0);
        else if (page == 1)
            selection = MSG_SELECT(CommuDesc, CommuCharSel2, 0);
        else if (page == 2)
            selection = MSG_SELECT(CommuDesc, CommuCharSel3, 0);
        else if (page == 3)
            selection = MSG_SELECT(CommuDesc, CommuCharSel4, 0);
        else
            selection = MSG_SELECT(CommuDesc, CommuCharSel5, 0);

        if (selection == 999)
            return -1;

        if (page == 0)
        {
            if (selection >= 0 && selection <= 5)
                return selection + 1;
            if (selection == 6)
                page = 1;
        }
        else if (page == 1)
        {
            if (selection >= 0 && selection <= 4)
                return selection + 7;
            if (selection == 5)
                page = 0;
            else if (selection == 6)
                page = 2;
        }
        else if (page == 2)
        {
            if (selection >= 0 && selection <= 4)
                return selection + 12;
            if (selection == 5)
                page = 1;
            else if (selection == 6)
                page = 3;
        }
        else if (page == 3)
        {
            if (selection >= 0 && selection <= 4)
                return selection + 17;
            if (selection == 5)
                page = 2;
            else if (selection == 6)
                page = 4;
        }
        else
        {
            if (selection >= 0 && selection <= 5)
                return selection + 22;
            if (selection == 6)
                page = 3;
        }
    }

    return -1;
}

void SetUpFavorites()
{
    int page = 0;

    while (true)
    {
        int start = 24 + (page * 6);
        int i = 0;

        while (i < 6)
        {
            SET_MSG_VAR(i + 1, GET_COUNT(start + i), 0);
            i = i + 1;
        }

        SEL_DEFKEY(PadButton.Circle, 999);
        if (page < 2)
            SEL_DEFKEY(PadButton.R, 996);
        if (page > 0)
            SEL_DEFKEY(PadButton.L, 997);

        int selection;
        if (page == 0)
            selection = SEL(SelectFavorites);
        else if (page == 1)
            selection = SEL(SelectFavorites1);
        else
            selection = SEL(SelectFavorites2);

        if (selection == 999)
            return;

        if (selection >= 0 && selection < 6)
        {
            int value = SelectNumber(4);
            if (value != -1)
                SET_COUNT(start + selection, value);
        }
        else if (selection == 996 && page < 2)
            page = page + 1;
        else if (selection == 997 && page > 0)
            page = page - 1;
    }
}

