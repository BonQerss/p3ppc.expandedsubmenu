import("Common/TartarusEntrance.flow");

global bool isFieldBf;

void f015_018_shortcut_hook()
{
    tartarus_shortcut();
}

void CallOriginalSquareMenu()
{
    f015_018_shortcut();
}

void HIT_SCRIPT_255_hook()
{
    MSG_WND_DSP();
    MSG(WHAT_DO_YOU_WANT);
    SEL_DEFKEY(14, 4);
    int clockSel = SEL(SAVE_OR_HEAL);
    MSG_WND_CLS();
    if (clockSel == 0)
    {
        FADE(1, 10);
        FUNCTION_000F();
        SAVE_MENU();
        FUNCTION_000D(0);
        FUNCTION_000F();
        return;
    }
    else if (clockSel == 1) HealParty();
    else if (clockSel == 2) HealEveryone();
    else if (clockSel == 3) BattleTutorials();
}

void f015_018_init_hook()
{
    SaveEveryday();
    f015_018_init_unhooked();
}
