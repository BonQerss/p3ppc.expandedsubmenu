import("FirstTimeSetup.msg");

void TurnOnRecommended()
{
    BIT_ON(5161);
    BIT_ON(5162);
    BIT_ON(5153);
    BIT_OFF(5154);
    BIT_ON(5155);
    BIT_ON(5156);
    BIT_ON(5157);
    BIT_ON(5158);
    BIT_OFF(5159);
    BIT_OFF(5160);
    BIT_OFF(5180);
    BIT_ON(5165);
    BIT_ON(5166);
    BIT_ON(5167);
    BIT_ON(5168);
    BIT_OFF(5170);
    BIT_OFF(5171);
    BIT_ON(5178);
    BIT_ON(5179);
}

void FirstTimeSetup()
{
    int restoreTarTar = GET_COUNT(1);

    MSG_WND_DSP();
    FUNCTION_002D(SquareMenuConfig);
    MSG_WND_CLS();

    int i = 0;

    while (i < 8)
    {
        BIT_OFF(5154 + i);
        i = i + 1;
    }

    i = 0;
    while (i < 3)
    {
        BIT_OFF(5172 + i);
        i = i + 1;
    }

    BIT_ON(5164);

    i = 0;
    while (i < 7)
    {
        BIT_OFF(5165 + i);
        i = i + 1;
    }

    BIT_OFF(5178);

    TurnOnRecommended();
    SET_COUNT(1, restoreTarTar);
    MenuOptions();
}

int ToggleOption(int startMsg, int startFlag, int selection)
{
    MSG_WND_DSP();
    MSG(startMsg + selection);
    SEL_DEFKEY(PadButton.Circle, 2);
    int sel = SEL(ToggleMenu);
    MSG_WND_CLS();

    if (sel == 0)
        BIT_ON(startFlag + selection);
    else if (sel == 1)
        BIT_OFF(startFlag + selection);

    return sel;
}

void MenuOptions()
{
    if (!BIT_CHK(5153))
    {
        FirstTimeSetup();
        return;
    }

    int restoreTarTar = GET_COUNT(1);
    bool done = false;
    int pageNum = 0;

    while (!done)
    {
        int i = 0;

        while (i < 8)
        {
            SET_MSG_VAR(i, 576 + BIT_CHK(5154 + i), 6);
            i = i + 1;
        }

        SET_MSG_VAR(8, 576 + BIT_CHK(5172), 6);
        SET_MSG_VAR(9, 576 + BIT_CHK(5162), 6);

        SEL_DEFKEY(PadButton.Circle, 18);
        SEL_DEFKEY(PadButton.Square, 18);

        int mask;
        if (pageNum == 0)
        {
            mask = 3040;
            if (!ModMenuShown())
            {
                mask += 1;
                mask -= 32;
            }
            SEL_DEFKEY(PadButton.Right, 10);
            SEL_DEFKEY(PadButton.Left, 10);
        }
        else
        {
            mask = 1055;
            if (!ModMenuShown())
                mask += 32;
            SEL_DEFKEY(PadButton.Right, 11);
            SEL_DEFKEY(PadButton.Left, 11);
        }

        int selection = MSG_SELECT(SquareMenuOptions_Text + pageNum, SquareMenuOptions, mask);

        if (selection == 8)
            ToggleOption(RemoveLunchtimeInvites_About, 5172, 0);
        else if (selection == 9)
            ToggleOption(GBHE_About, 5162, 0);
        else if (selection < 8)
        {
            int state = ToggleOption(ModMenu_About, 5154, selection);

            if (selection == 6)
            {
                if (state == 0) BIT_ON(5180);
                else if (state == 1) BIT_OFF(5180);
            }

            if (state == 0)
            {
                if (selection == 0)
                    ModMenuOptionsToggle();
                else if (selection == 3)
                    DungeonOptionsToggle();
                else if (selection == 4)
                    FindAFriendOptionsToggle();
            }
            else if (selection == 3)
            {
                BIT_OFF(5165);
                BIT_OFF(5166);
                BIT_OFF(5167);
                BIT_OFF(5168);
            }
        }
        else if (selection == 10 || selection == 11)
        {
            if (pageNum == 0)
                pageNum = 1;
            else
                pageNum = 0;
        }
        else
            done = true;
    }

    if (!ModMenuEnabled())
    {
        MSG_WND_DSP();
        MSG(OptionsWarning);
    }

    if (BIT_CHK(5154) && !BIT_CHK(5176))
    {
        MSG_WND_DSP();
        MSG(ModMenuWarning);
        MSG(ModMenuWarning_2);
        BIT_ON(5176);
    }

    MSG_WND_CLS();
    SET_COUNT(1, restoreTarTar);
}

void FindAFriendOptionsToggle()
{
    while (true)
    {
        SET_MSG_VAR(0, 576 + BIT_CHK(5161), 6);
        SET_MSG_VAR(1, 576 + BIT_CHK(5158), 6);
        SEL_DEFKEY(PadButton.Circle, 2);
        SEL_DEFKEY(PadButton.Square, 2);

        int selection = MSG_SELECT(FindAFriendOptions_Text, FindAFriendOptions, 0);
        if (selection != 0)
            return;

        MSG_WND_DSP();
        MSG(SPOILER_TOGGLE);
        SEL_DEFKEY(PadButton.Circle, 1);
        int sel = SEL(ToggleMenu);

        if (sel == 0)
            BIT_ON(5161);
        else if (sel == 1)
            BIT_OFF(5161);

        MSG_WND_CLS();
    }
}

void ModMenuOptionsToggle()
{
    while (true)
    {
        SET_MSG_VAR(0, 576 + BIT_CHK(5163), 6);
        SET_MSG_VAR(1, 576 + BIT_CHK(5154), 6);
        SEL_DEFKEY(PadButton.Circle, 2);
        SEL_DEFKEY(PadButton.Square, 2);

        int selection = MSG_SELECT(ModMenuFirst_Text, ModMenuFirst, 0);
        if (selection != 0)
            return;

        MSG_WND_DSP();
        MSG(ShowModMenuFirst);
        SEL_DEFKEY(PadButton.Circle, 1);
        int sel = SEL(ToggleMenu);

        if (sel == 0)
            BIT_ON(5163);
        else if (sel == 1)
            BIT_OFF(5163);

        MSG_WND_CLS();
    }
}

void DungeonOptionsToggle()
{
    int page = 0;

    while (true)
    {
        SET_MSG_VAR(0, 576 + BIT_CHK(5165), 6);
        SET_MSG_VAR(1, 576 + BIT_CHK(5166), 6);
        SET_MSG_VAR(2, 576 + BIT_CHK(5167), 6);
        SET_MSG_VAR(3, 576 + BIT_CHK(5168), 6);
        SET_MSG_VAR(4, 576 + BIT_CHK(5169), 6);
        SET_MSG_VAR(5, 576 + BIT_CHK(5171), 6);
        SET_MSG_VAR(6, 576 + BIT_CHK(5170), 6);
        SET_MSG_VAR(7, 576 + BIT_CHK(5178), 6);
        SET_MSG_VAR(8, 576 + BIT_CHK(5179), 6);

        SEL_DEFKEY(PadButton.Circle, 999);

        int selection;

        if (page == 0)
        {
            SEL_DEFKEY(PadButton.R, 5);
            selection = MSG_SELECT(DungeonOptions_Text, DungeonOptionsPage1, 0);

            if (selection == 999 || selection == 6)
                return;

            if (selection == 5)
            {
                page = 1;
                continue;
            }

            int state = ToggleOption(ShowTheClock_About, 5165, selection);

            if (selection == 0)
            {
                if (state == 1)
                    BIT_OFF(5175);
                else if (state == 0)
                    HealingClockOptions();
            }
        }
        else
        {
            SEL_DEFKEY(PadButton.L, 4);
            selection = MSG_SELECT(DungeonOptions_Text_2, DungeonOptionsPage2, 0);

            if (selection == 999 || selection == 5)
                return;

            if (selection == 4)
            {
                page = 0;
                continue;
            }

            if (selection == 0)
                ToggleOption(DefaultDirectCommands_About, 5171, 0);
            else if (selection == 1)
                ToggleOption(GameOverSkip_About, 5170, 0);
            else if (selection == 2)
                ToggleOption(TartarusWarp_About, 5178, 0);
            else if (selection == 3)
                ToggleOption(RareChestWarning_About, 5179, 0);
        }
    }
}

void HealingClockOptions()
{
    while (true)
    {
        SET_MSG_VAR(0, 576 + BIT_CHK(5175), 6);
        SEL_DEFKEY(PadButton.Circle, 1);
        SEL_DEFKEY(PadButton.Square, 1);
        int clockSel = MSG_SELECT(ShowClockOptions_Text, ShowClockOptions, 0);

        if (clockSel != 0)
            return;

        SET_MSG_VAR(2, 1313, 5);
        MSG_WND_DSP();
        MSG(ShowClock_Traesto);
        int traestoSel = SEL(ToggleMenu);

        if (traestoSel == 0)
            BIT_ON(5175);
        else if (traestoSel == 1)
            BIT_OFF(5175);

        MSG_WND_CLS();
    }
}
